@using ZewelryStore.Models
@model Product

@{
    ViewBag.Title = $"{ViewBag.Operation} Product";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">

        <div class="border-bottom pb-2 mb-4">
            <h1 class="h3 fw-normal mb-0">@ViewBag.Operation Product</h1>
        </div>

        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="CategoryId" />

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold">Product details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Stock" class="form-label">Quantity In Stock</label>
                            <input asp-for="Stock" type="number" min="0" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold">Product image</div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" class="img-thumbnail bg-light w-25 mb-3" />
                    }
                    <label for="imageUpload" class="form-label">Upload Image</label>
                    <input type="file" class="form-control" id="imageUpload" asp-for="ImageFile" accept="image/*" />
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light fw-semibold">Category</div>
                        <div class="card-body">
                            @foreach (Category category in ViewBag.Categories)
                            {
                                bool isChecked = Model.CategoryId == category.CategoryId;
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" id="cat-@category.CategoryId"
                                           name="catId" value="@category.CategoryId" checked="@isChecked" />
                                    <label class="form-check-label" for="cat-@category.CategoryId">@category.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light fw-semibold">Ingredients</div>
                        <div class="card-body">
                            @foreach (Ingredient ingredient in ViewBag.Ingredients)
                            {
                                bool isChecked = Model.ProductIngredients != null
                                    && Model.ProductIngredients.Any(i => i.IngredientId == ingredient.IngredientId);
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="ing-@ingredient.IngredientId"
                                           name="ingredientIds" value="@ingredient.IngredientId" checked="@isChecked" />
                                    <label class="form-check-label" for="ing-@ingredient.IngredientId">@ingredient.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-warning rounded-pill px-4">Save</button>
            </div>
        </form>
    </div>
</div>

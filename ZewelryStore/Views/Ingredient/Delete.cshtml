@using ZewelryStore.Models
@model Ingredient

@{
    ViewBag.Title = $"Delete {Model.Name} material";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-semibold">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Delete material
            </div>
            <div class="card-body">
                <h2 class="h5 fw-normal">Are you sure you want to delete <strong>@Model.Name</strong>?</h2>
                <p class="text-secondary small mb-4">This can't be undone.</p>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="IngredientId" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
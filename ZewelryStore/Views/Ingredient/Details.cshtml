@using ZewelryStore.Models
@model Ingredient

@{
    ViewBag.Title = "Materials details";
}

<div class="border-bottom pb-2 mb-4">
    <h1 class="h3 fw-normal mb-0">@Model.Name products</h1>
</div>

@if (Model.ProductIngredients != null && Model.ProductIngredients.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-semibold">Products</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th class="text-end">Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var productIngredient in Model.ProductIngredients)
                    {
                        <tr>
                            <td>@productIngredient.Product.Name</td>
                            <td class="text-secondary">@productIngredient.Product.Description</td>
                            <td class="text-end">@productIngredient.Product.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-light border">No products use this material yet.</div>
}

<a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
    <i class="bi bi-arrow-left me-1"></i>Back to List
</a>
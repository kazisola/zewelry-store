@using ZewelryStore.Models
@model IEnumerable<Ingredient>

    @{
        ViewBag.Title = "List of jewelry materials";
    }

<h1>Jewelry Materials</h1>

<div>
    <a asp-action="Create">Create Material</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(Ingredient i in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => i.Name)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@i.IngredientId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
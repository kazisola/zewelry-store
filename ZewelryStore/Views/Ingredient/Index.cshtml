@using ZewelryStore.Models
@model IEnumerable<Ingredient>

@{
    ViewBag.Title = "List of jewelry materials";
}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
    <div>
        <h1 class="h3 fw-normal mb-0">Jewelry Materials</h1>
        <span class="text-secondary small">@Model.Count() materials</span>
    </div>
    <a asp-action="Create" class="btn btn-warning rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i>Create Material
    </a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Ingredient i in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => i.Name)</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@i.IngredientId"
                               class="btn btn-sm btn-outline-secondary rounded-pill">Details</a>
                            <a asp-action="Edit" asp-route-id="@i.IngredientId"
                               class="btn btn-sm btn-warning rounded-pill">Edit</a>
                            <a asp-action="Delete" asp-route-id="@i.IngredientId"
                               class="btn btn-sm btn-outline-danger rounded-pill">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="2" class="text-center text-secondary py-4">No materials yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
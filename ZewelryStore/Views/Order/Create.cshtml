@using ZewelryStore.Models
@model OrderViewModel

@{
    ViewBag.Title = "Create Order";
}

<style>
    .product-img {
        height: 220px;
        object-fit: contain;
    }

    .product-card {
        transition: box-shadow .15s ease, transform .15s ease;
    }

        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>

<div class="d-flex justify-content-between align-items-baseline border-bottom pb-2 mb-4">
    <h1 class="h3 fw-normal mb-0">Create Order</h1>
    <span class="text-secondary small">@Model.Products.Count() products</span>
</div>

<div class="row g-3">
    @foreach (Product product in Model.Products)
    {
        var totalCents = (int)Math.Round(product.Price * 100);
        var whole = totalCents / 100;
        var fraction = totalCents % 100;

        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <form asp-action="AddItem" method="post" class="h-100">
                <div class="card product-card h-100 shadow-sm">
                    <img src="@Url.Content(product.ImageUrl ?? "~/images/placeholder.png")"
                         class="card-img-top product-img bg-light p-3"
                         alt="@product.Description" />

                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 fw-normal text-truncate mb-1" title="@product.Name">@product.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <p class="small text-secondary text-truncate mb-2">@product.Description</p>
                        }

                        <div class="mb-1">
                            <span class="align-top small">$</span><span class="fs-3">@whole.ToString("N0")</span><span class="align-top small">@fraction.ToString("00")</span>
                        </div>

                        <div class="text-success small mb-3">In Stock</div>

                        <input type="hidden" value="@product.ProductId" name="prodId" />

                        <div class="input-group input-group-sm mb-2 mt-auto">
                            <label class="input-group-text" for="qty-@product.ProductId">Qty</label>
                            <input id="qty-@product.ProductId" type="number" name="prodQty"
                                   value="1" min="1" class="form-control" />
                        </div>

                        <button class="btn btn-warning rounded-pill w-100" type="submit">Add to Cart</button>
                    </div>
                </div>
            </form>
        </div>
    }
</div>
